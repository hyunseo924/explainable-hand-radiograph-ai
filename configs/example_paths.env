# Copy this file to ./configs/paths.env and edit the values for the local setup.
# Paths may be relative to the Supplementary_Code_2 package root.

PYTHON_BIN=python
CUDA_VISIBLE_DEVICES=0

# De-identified classification images and exclusions.
DATA_ROOT=./data/classification
REMOVAL_CSV=./data/Removal.csv

# The reference image must be available under each image root used for Grad-CAM.
# Example form only; replace with the actual relative image path used locally.
TEMPLATE_RELATIVE_PATH=F_20_45/reference_template.jpg

# Locations for manually labelled segmentation data and generated ray datasets.
SEGMENTATION_LABEL_ROOT=./data/segmentation_labels
SEGMENTATION_OUTPUT_ROOT=./outputs/segmentation
# After visual review and any necessary manual correction, place the final
# component masks under {metacarpal,phalanx}/ray{2,3,4}/ at this location.
REFINED_COMPONENT_MASK_ROOT=./data/reviewed_component_masks
RAY_ROOT=./outputs/ray_masks

# Default locations generated by the training scripts. To evaluate separately
# supplied checkpoints, replace these with the matching paths under ./weights/.
BASELINE_CHECKPOINT_DIR=./outputs/checkpoints/baseline
ABLATION_CHECKPOINT_DIR=./outputs/checkpoints/ablation
YOLO_WEIGHT_ROOT=./outputs/segmentation/yolo
MEDSAM_WEIGHT_ROOT=./outputs/segmentation/medsam

# Parent directory containing baseline_ci_evaluation/ and ablation_ci_evaluation/.
MENOPAUSE_RESULTS_ROOT=./outputs
